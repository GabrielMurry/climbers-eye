{
  "compilerOptions": {
    "target": "ES6",
    "jsx": "react-native",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "typeRoots": ["./src/types"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "src/screens/boulder/BoulderStatsScreen.js",
    "src/screens/boulder/ReportBoulderScreen.js"
  ],
  "exclude": ["node_modules"],
  "extends": "expo/tsconfig.base"
}
